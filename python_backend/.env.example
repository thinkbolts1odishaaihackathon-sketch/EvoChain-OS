# OPTION 1: Unified PostgreSQL Connection URL (Recommended for Cloud Providers)
# Works directly with: Neon, Supabase, AWS RDS, Render, Railway, ElephantSQL, etc.
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?sslmode=[require/prefer]
POSTGRES_URL=postgresql://evochain_user:j0v7mzq1xvgaUioEIymUoPppbf5ogZRw@dpg-db51he2jnfac738tk6kg-a.singapore-postgres.render.com/evochain
# Alternative alias supported:
# DATABASE_URL=postgresql://postgres:your_db_password@db.supabase.co:5432/postgres?sslmode=require

# OPTION 2: Discrete PostgreSQL Parameters (Standard PG Environment Variables)
# PGHOST=ep-cool-flower-123456.us-east-1.aws.neon.tech
# PGPORT=5432
# PGUSER=postgres
# PGPASSWORD=your_secure_password
# PGDATABASE=sahirate_db
# PGSSLMODE=require

# Note: If no PostgreSQL URL or host is configured, the server automatically 
# and seamlessly runs with an embedded persistent SQLite fallback (sahirate_users.db),
# ensuring zero downtime and offline development capability.
