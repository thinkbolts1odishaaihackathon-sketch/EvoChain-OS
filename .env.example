# EvoChain-OS Live AI Configuration
# You can set your Google Gemini API Key here (or directly in the app via the "⚡ AI Engine" header button)
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Default Model (gemini-3.8-flash is the standard agentic model)
VITE_GEMINI_MODEL=gemini-3.8-flash

# Backend API Endpoint (Render Cloud Production)
VITE_BACKEND_URL=https://evochain-os.onrender.com

# ==============================================================================
# PostgreSQL Database Hosting API & Connection URL
# Compatible with Neon, Supabase, AWS RDS, Render, Railway, ElephantSQL, etc.
# ==============================================================================
POSTGRES_URL=postgresql://postgres:your_password@ep-flower-123456.us-east-1.aws.neon.tech/sahirate_db?sslmode=require
# Alternative discrete PG variables:
# PGHOST=ep-flower-123456.us-east-1.aws.neon.tech
# PGPORT=5432
# PGUSER=postgres
# PGPASSWORD=your_password
# PGDATABASE=sahirate_db
# PGSSLMODE=require

